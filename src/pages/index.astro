---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { Card, CardGrid } from "@astrojs/starlight/components";
import CodeDemo from "../components/CodeDemo.astro";
import InstallDemo from "../components/InstallDemo.astro";

import { Image } from "astro:assets";

import HeroBackground from "../assets/home/home-bg-2.png";
import FoxRockWhats from "../assets/home/foxrocklogo.png";
import Spyral from "../assets/home/spiral.png";
import WhatsbotcordLogo from "../assets/whatsbotcord_logo.png";
---

<StarlightPage
  frontmatter={{
    title: "Whatsbotcord.js",
    template: "splash",

    head: [
      {
        // (1) Resetting star-light CSS (This page only)
        tag: "style",
        content: `
          html, body { overflow-x: hidden;}
          main, main:where(.astro-rhk77a7l), :root main { padding: 0 !important; --sl-main-pad: 0 !important; }
          .content-panel:has(#_top) { display: none !important; }
          footer.sl-flex { display: none !important; }
          .sl-container, .content-panel { max-width: none !important; padding: 0 !important; margin: 0 !important; }
          :root[data-theme='dark'] {
            --sl-color-black: #140f25 !important;
            --sl-color-bg-nav: #140f25 !important;
            --sl-color-accent: #5e4ec2 !important;
          }
          @media (prefers-color-scheme: dark) {
            :root:not([data-theme='light']) {
              --sl-color-black: #140f25 !important;
              --sl-color-bg-nav: #140f25 !important;
              --sl-color-accent: #5e4ec2 !important;
            }
          }
        `,
      },
    ],
  }}
  hasSidebar={false}
>
  <main class="no-content relative">
    <!-- 2. Aquí va el resto de tu contenido, con estilos custom para centrarlo si quieres -->

    <Image src={HeroBackground} class="background hero-bg" alt="background" />

    <!-- Hero section -->
    <section id="hero-section">
      <Image
        src={FoxRockWhats}
        alt="fox-rock-whats-img"
        class="fox-img"
        style="position: fixed; pointer-events: none;"
      />
      <Image src={Spyral} alt="spyral-img" class="spyral-img" style="position: fixed; pointer-events: none;" />

      <div class="hero-content">
        <div class="hero-text">
          <h1>Whatsbotcord.js</h1>
          <p>
            Build WhatsApp bots with Discord-like commands.<br />
            TypeScript-first. By developers, for developers.
          </p>
          <div class="hero-buttons">
            <a href="/getting-started/quickstart" class="btn-primary">Get Started →</a>
            <a
              href="https://github.com/KristanLaimon/WhatsBotCord.js"
              class="btn-secondary"
              target="_blank"
              rel="noopener"
            >
              Source-code
            </a>
            <a class="btn-tertiary" href="/playground">Playground/Editor</a>
          </div>
        </div>
        <Image src={WhatsbotcordLogo} alt="whatsbotcord-logo" class="whatsbotcord-logo" />
      </div>
    </section>

    <!-- Rest of page -->
    <section class="rest-of-page">
      <InstallDemo />

      <h2 style="color: white;">Get started in seconds</h2>

      <CodeDemo />

      <h2>Why Whatsbotcord?</h2>

      <CardGrid>
        <Card title="Discord-Inspired Commands" icon="rocket">
          Create commands like `!hello` with a simple, familiar syntax inspired by Discord bots. Supports prefixes,
          aliases, and tags.
        </Card>
        <Card title="TypeScript Support" icon="laptop">
          Fully typed with TypeScript for robust development, auto-completion, and type-safe interfaces out of the box.
        </Card>
        <Card title="Simplified Baileys Wrapper" icon="puzzle">
          Abstracts complex Baileys.js internals so you can focus on building features instead of fighting the WhatsApp
          protocol.
        </Card>
        <Card title="Group & Individual Messaging" icon="comment">
          Seamlessly interact with WhatsApp groups and individual chats. Fetch group data, mention members, and more.
        </Card>
        <Card title="Extensible & Pluggable" icon="bars">
          Modular middleware and plugin architecture. Add rate-limiting, permissions, or your own custom logic with
          ease.
        </Card>
        <Card title="Built-in Testing" icon="approve-check-circle">
          Mock entire chat sessions with `ChatMock` — test your commands locally without a real WhatsApp connection.
        </Card>
      </CardGrid>

      <hr class="separator" />

      <div class="footer-credits">
        <p>
          Proudly built and maintained by <strong>
            <a href="https://github.com/KristanLaimon">@KristanLaimon</a>
          </strong>. Concept art original by me assisted by AI 🦊.
        </p>
        <a href="https://github.com/KristanLaimon">
          <img
            src="https://github.com/KristanLaimon.png"
            alt="KristanLaimon"
            width="90"
            height="90"
            class="mx-auto avatar"
          />
        </a>
      </div>

      <!-- Blank space -->
      <div class="blank-space-footer"></div>
    </section>
  </main>
</StarlightPage>

<style>
  .blank-space-footer {
    height: 4rem;
    width: 100%;

    @media (min-width: 768px) {
      height: 8rem;
    }
    /* @media (min-width: 1024px) {
      width: 80%;
    }
    @media (min-width: 1280px) {
      width: 70%;
    } */
  }
  .background {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    max-width: none !important;
    height: auto;
    max-height: 100%;
    object-fit: cover;
    object-position: top;
    z-index: -1;
    opacity: 0.7; /* Subimos la opacidad para que la imagen luzca genial donde es transparente */
    pointer-events: none;
  }

  #hero-section {
    --var-header-height-starlight: 4rem;
    width: 100%;
    height: calc(100vh - var(--var-header-height-starlight));
    position: relative;
    /* Fijo en oscuro para que los PNG transparentes no se mezclen con blanco en Light Mode */
    /*background-color: #140f25;*/

    /* @media (min-width: 1280px) {
      height: vh;
    } */

    /* md Tailwind */
    @media (min-width: 48rem) {
      height: 100vh;
    }

    /* lg tailwind */
    @media (min-width: 64rem) {
      height: 87vh;
    }

    /* if is too vertical (monitors set in portrait mode for example) */
    @media (min-width: 64rem) and (min-height: 64rem) {
      height: 40vh;
    }

    @media (min-height: 64rem) {
      height: fit-content;
      padding: 2.8rem 0;
    }

    @media (min-width: 90rem) {
      height: fit-content;
      padding: 4rem 0;
    }

    img {
      object-fit: cover;
    }

    .spyral-img {
      display: none; /* No renderizar en móviles */
      position: fixed;
      bottom: 0;
      left: 0;
      width: 70%; /* Más pequeño en móviles (antes 120%) */
      height: auto;
      z-index: 2; /* Subimos a 2 para estar encima del degradado */
      opacity: 0.5;
      pointer-events: none;

      @media (min-width: 640px) {
        width: 100%;
      }
      @media (min-width: 768px) {
        display: block; /* Visible a partir de tablet/desktop */
        width: 90%;
        opacity: 42%;
      }
      @media (min-width: 1024px) {
        width: 80%;
      }
      @media (min-width: 1280px) {
        width: 70%;
      }
    }

    .whatsbotcord-logo {
      width: 53%; /* Tamaño adecuado para móvil */
      height: auto;
      z-index: 3;
      /* Sombra oscura ligera en su contorno */
      filter: drop-shadow(0 0 25px rgba(0, 0, 0, 0.95));

      @media (min-width: 640px) {
        width: 45%;
      }
      @media (min-width: 768px) {
        width: 30%;
      }
      @media (min-width: 768px) and (max-aspect-ratio: 4/5) {
        width: 45%; /* Aumentamos el tamaño en pantallas muy altas y estrechas */
      }
      @media (min-width: 1024px) {
        width: 25%;
      }
      @media (min-width: 1280px) {
        width: 22%; /* Ligeramente más grande (antes 18%) */
      }
      @media (min-width: 1536px) {
        width: 24%; /* Ligeramente más grande (antes 20%) */
      }
    }

    .fox-img {
      position: fixed;
      right: -10px;
      bottom: -10px;
      width: 75%;
      height: auto;
      z-index: 4;
      pointer-events: none;

      @media (min-width: 640px) {
        width: 60%;
      }
      @media (min-width: 768px) {
        width: 45%;
      }
      @media (min-width: 1024px) {
        width: 35%;
      }
      @media (min-width: 1280px) {
        width: 30%;
      }
    }

    .hero-content {
      position: relative;
      z-index: 10;
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column-reverse;
      align-items: center;
      justify-content: center;
      gap: 2rem;
      /* Compensamos el solapamiento del main para centrar el contenido en el espacio visible */
      padding: 10rem 2rem 0 2rem; /* Mayor compensación por el solapamiento de 10rem en móviles */
      box-sizing: border-box;

      @media (min-height: 64rem) {
        height: 50%;
      }

      @media (min-width: 768px) {
        padding-top: 15rem;
        padding-bottom: 0;
      }

      @media (min-width: 1024px) {
        flex-direction: row;
        gap: 6rem;
        padding-top: 20rem; /* En desktop compensamos los 20rem */
        padding-bottom: 0;
      }

      .hero-text {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 1.5rem;

        @media (min-width: 1024px) {
          align-items: flex-start;
          text-align: left;
        }

        h1,
        p {
          margin: 0;
          color: #ffffff;
          text-shadow:
            0 2px 10px rgba(0, 0, 0, 0.8),
            0 0 25px rgba(0, 0, 0, 0.95);
        }

        h1 {
          @media (min-width: 1280px) {
            font-size: 3.4rem; /* Título más grande en xl */
          }
          @media (min-width: 1536px) {
            font-size: 4rem; /* Aún más grande en 2xl */
          }
        }

        p {
          font-size: 1.25rem;
          /* Sombra mucho más intensa (y un borde de brillo negro) para móviles, 
             para que el texto no se pierda con el zorro de fondo */
          text-shadow:
            0 0 4px rgba(0, 0, 0, 1),
            0 0 12px rgba(0, 0, 0, 1),
            0 2px 10px rgba(0, 0, 0, 1),
            0 0 25px rgba(0, 0, 0, 1);

          @media (min-width: 1024px) {
            /* En desktop, que ya no estorba el zorro igual, devolvemos la sombra normal */
            text-shadow:
              0 2px 10px rgba(0, 0, 0, 0.8),
              0 0 25px rgba(0, 0, 0, 0.95);
          }
        }

        .hero-buttons {
          display: flex;
          gap: 1rem;
          flex-wrap: wrap;
          justify-content: center;

          @media (min-width: 1024px) {
            justify-content: flex-start;
          }

          a {
            text-decoration: none;
            /* 1. Ajusta el padding: debe ser mucho más ancho a los lados (horizontal) que arriba/abajo (vertical) */
            padding: 0.75rem 1.5rem;
            /* 2. EL SECRETO: Usa un valor absoluto en píxeles muy alto en lugar de % */
            border-radius: 9999px;
            color: var(--sl-color-white); /* Color adaptable al light/dark mode */
            display: inline-flex;
            align-items: center;
            gap: 0.5rem; /* Espacio entre el texto y la flecha/icono */
            font-weight: 500;
            transition: all 0.2s ease;
          }

          a.btn-primary {
            background-color: var(--sl-color-accent);
            /* Opcional: El botón tiene un ligero resplandor neón */
            box-shadow: 0 0 9px var(--sl-color-accent);
            color: #ffffff !important; /* Siempre blanco porque el fondo primario es oscuro en ambos temas */
          }

          a.btn-primary:hover {
            background-color: var(--sl-color-text-accent);
            box-shadow: 0 0 20px var(--sl-color-text-accent);
            color: #000000 !important; /* Texto oscuro para mejor contraste al brillar */
          }

          a.btn-secondary {
            /* En tu imagen de referencia, el botón secundario no tiene fondo sólido, es solo texto */
            background-color: var(--sl-color-gray-5);
            color: var(--sl-color-white); /* Oscuro en light mode, blanco en dark mode */
          }

          a.btn-secondary:hover {
            color: var(--sl-color-gray-2);
          }

          a.btn-tertiary {
            background-color: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: rgb(255, 255, 255);
            backdrop-filter: blur(8px);
          }

          a.btn-tertiary:hover {
            background-color: rgba(255, 255, 255, 0.08);
            border-color: var(--sl-color-accent);
            color: white !important;
            box-shadow: 0 0 15px var(--sl-color-accent);
          }
        }
      }
    }
  }

  main {
    max-width: 960px;
    margin: -10rem auto 0; /* Mayor solapamiento en móviles (antes -5rem) */
    padding: 0 2rem;
    position: relative;
    z-index: 100;

    @media (min-width: 768px) {
      margin-top: -15rem; /* Transición suave en tablets */
    }

    @media (min-width: 1024px) {
      margin-top: -20rem; /* Tu valor de 20rem se mantiene en pantallas grandes */
    }

    h2 {
      margin-top: 3rem;
      margin-bottom: 1.5rem;
      font-size: 2rem;

      /* Contorno negro intenso para mejorar contraste en móviles por el solapamiento */
      text-shadow:
        0 0 4px rgba(0, 0, 0, 1),
        0 0 12px rgba(0, 0, 0, 1),
        0 2px 10px rgba(0, 0, 0, 1),
        0 0 25px rgba(0, 0, 0, 1);

      @media (min-width: 768px) {
        text-shadow: none; /* Quitamos el contorno en desktop/tablets como pediste */
      }
    }

    .separator {
      margin-top: 4rem;
      margin-bottom: 2rem;
      border-color: var(--sl-color-gray-5);
    }

    .footer-credits {
      text-align: center;
      margin-top: 2rem;

      .avatar {
        border-radius: 50%;
        margin: 1rem auto;
        display: block;
      }
    }
  }

  .rest-of-page {
    position: relative;
    z-index: 10;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  function initParallax() {
    gsap.registerPlugin(ScrollTrigger);

    // Limpiamos ScrollTriggers anteriores en caso de re-inicialización por astro
    ScrollTrigger.getAll().forEach(trigger => trigger.kill());

    // Animación de la opacidad del fondo al llegar al 70% del scroll de la página
    gsap.to(".background", {
      opacity: 0.15,
      scrollTrigger: {
        trigger: "main",
        start: "70% top",
        end: "bottom bottom",
        scrub: 1,
      },
    });

    let mm = gsap.matchMedia();

    // Móvil (< 768px)
    mm.add("(max-width: 767px)", () => {
      gsap.to(".fox-img", {
        opacity: 0.15,
        scrollTrigger: {
          trigger: ".footer-credits",
          start: "top bottom",
          end: "bottom bottom",
          scrub: 1,
        },
      });
    });

    // Desktop (>= 768px)
    mm.add("(min-width: 768px)", () => {
      // El zorro mantiene opacidad total (no animado). El spyral baja a 0.2.
      gsap.to(".spyral-img", {
        opacity: 0.2,
        scrollTrigger: {
          trigger: ".footer-credits",
          start: "top bottom",
          end: "bottom bottom",
          scrub: 1,
        },
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      initParallax();
      setTimeout(() => ScrollTrigger.refresh(), 200);
    });
  } else {
    initParallax();
    setTimeout(() => ScrollTrigger.refresh(), 200);
  }
  document.addEventListener("astro:page-load", () => {
    initParallax();
    setTimeout(() => ScrollTrigger.refresh(), 200);
  });
  window.addEventListener("load", () => {
    ScrollTrigger.refresh();
  });
</script>
