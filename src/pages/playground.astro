          await ctx.SendText("pong! 🏓");

              //Sending with caption
              //await ctx.SendImgWithCaption(MockMedia.Images.Frieren, "The eternal Journey");
              //await ctx.SendDocumentWithCustomName(MockMedia.Pdfs.Sample, "OneOfThePDF's of all time...");
              //await ctx.SendVideoWithCaption(MockMedia.Videos.BuckBunny, "Bunny bunny");

              //Sending without caption
              //await ctx.SendImg(MockMedia.Images.Frieren);
              //await ctx.SendDocument(MockMedia.Pdfs.Sample);
              //await ctx.SendVideo(MockMedia.Videos.BuckBunny);
        }
    }

    bot.Commands.Add(new PingCommand());

    bot.Start();


    Check (https://whatsbotcord.sbs/essential_concepts/sending/ for more info)
*/`;
---

<StarlightPage
  frontmatter={{
    title: "Whatsbotcord.js",
    template: "splash",
    head: [
      {
        // (1) Resetting star-light CSS (This page only)
        tag: "style",
        content: `
          .content-panel:has(#_top) { display: none !important; }
          .sl-container, .content-panel { max-width: none !important; padding: 0 !important; margin: 0 !important; }
          :root[data-theme='dark'] {
            --sl-color-black: #140f25;
            --sl-color-bg-nav: #140f25;
            --sl-color-accent: #5e4ec2;
          }
          @media (prefers-color-scheme: dark) {
            :root:not([data-theme='light']) {
              --sl-color-black: #140f25;
              --sl-color-bg-nav: #140f25;
              --sl-color-accent: #5e4ec2;
            }
          }
          footer.sl-flex {
            display: none;
          }

          :root main {
            padding: 0 !important;
          }

          html, body {
            overflow: hidden !important;
            height: 100vh !important;
          }
        `,
      },
    ],
  }}
  hasSidebar={false}
>
  <main class="not-content">
    <PlaygroundLayout client:only="svelte" initialCode={initialCodeTest} />
  </main>
</StarlightPage>
