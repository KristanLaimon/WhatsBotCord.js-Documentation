---
import Default from '@astrojs/starlight/components/Icon.astro';
import type { Props } from '@astrojs/starlight/props';
import { Image } from 'astro:assets';
import jsLogo from '../assets/javascript_logo.png';
import tsLogo from '../assets/typescript_logo.png';

const { name, ...attrs } = Astro.props;
---
{
  name === 'seti:javascript' ? (
    <Image src={jsLogo} alt="JavaScript" class="custom-tab-icon" {...attrs} />
  ) : name === 'seti:typescript' ? (
    <Image src={tsLogo} alt="TypeScript" class="custom-tab-icon" {...attrs} />
  ) : (
    <Default name={name} {...attrs} />
  )
}

<style>
  .custom-tab-icon {
    width: 1.2em;
    height: 1.2em;
    vertical-align: middle;
    display: inline-block;
    object-fit: contain;
  }
</style>
