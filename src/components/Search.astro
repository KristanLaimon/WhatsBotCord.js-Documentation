---
/**
 * Custom Search override — wraps the default Starlight Search
 * and prepends the ThemePicker component.
 * This ensures it remains visible in the header on both mobile and desktop.
 */
import type { Props } from "@astrojs/starlight/props";
import VersionSearch from "starlight-versions/components/VersionSearch.astro";
import ThemePicker from "./ThemePicker.astro";
import WidgetToggle from "./WidgetToggle.svelte";

const isQuickstart = Astro.url.pathname.includes('quickstart');
---

<div class="custom-search-group">
  <div class="mobile-theme-picker">
    <ThemePicker />
  </div>
  {isQuickstart && (
    <div class="widget-toggle-wrapper">
      <WidgetToggle client:load />
    </div>
  )}
  <!-- Starlight-versions custom Search component -->
  <VersionSearch {...Astro.props}><slot /></VersionSearch>
</div>

<style>
  .custom-search-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: nowrap;
  }
  
  @media (max-width: 400px) {
    .custom-search-group {
      gap: 0.5rem;
    }
  }

  @media (min-width: 50rem) {
    .mobile-theme-picker {
      display: none;
    }
  }
</style>
