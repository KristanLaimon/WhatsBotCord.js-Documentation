---
/**
 * Custom Header override — wraps the default Starlight Header
 * and appends the ThemePicker component.
 */
import type { Props } from "@astrojs/starlight/props";
import Default from "@astrojs/starlight/components/Header.astro";
import ThemePicker from "./ThemePicker.astro";
---

<div class="wb-header-wrap">
  <Default {...Astro.props}><slot /></Default>
  <div class="wb-theme-picker-slot">
    <ThemePicker />
  </div>
</div>

<style>
  .wb-header-wrap {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  
  .wb-theme-picker-slot {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0.5rem 0;
    border-top: 1px solid var(--sl-color-gray-5);
    background-color: var(--sl-color-bg-nav);
    width: 100%;
  }

  /* On desktop, restore it to absolutely float securely to the left of the search bar */
  @media (min-width: 50rem) {
    .wb-header-wrap {
      display: block;
      position: relative;
    }
    .wb-theme-picker-slot {
      position: absolute;
      top: 50%;
      right: 16rem; /* Ensures it stays left of the Search/Social icons */
      transform: translateY(-50%);
      padding: 0;
      border-top: none;
      background-color: transparent;
      width: auto;
      z-index: 10;
    }
  }
</style>
