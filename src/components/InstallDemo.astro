---
/**
 * InstallDemo — similar frame to CodeDemo but for installation commands
 */
---

<section class="install-demo" id="install-demo">
  <div class="cd-window">
    <div class="cd-titlebar">
      <span class="cd-dot cd-dot--red"></span>
      <span class="cd-dot cd-dot--yellow"></span>
      <span class="cd-dot cd-dot--green"></span>
      <div class="cd-tabs">
        <button class="cd-tab active" data-pm="npm" id="id-tab-npm">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="#cb3837"><path d="M1.763 0C.786 0 0 .786 0 1.763v20.474C0 23.214.786 24 1.763 24h20.474c.977 0 1.763-.786 1.763-1.763V1.763C24 .786 23.214 0 22.237 0zM5.13 5.323l13.837.019-.009 13.336h-3.46l.01-10.122h-3.456L12.04 22.08H5.136z"/></svg>
          npm
        </button>
        <button class="cd-tab" data-pm="pnpm" id="id-tab-pnpm">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="#f69220"><path d="M0 0v7.5h7.5V0zm8.25 0v7.5h7.5V0zM16.5 0v7.5H24V0zM0 8.25v7.5h7.5v-7.5zm8.25 0v7.5h7.5v-7.5zm8.25 0v7.5H24v-7.5zM0 16.5V24h7.5v-7.5zm8.25 0V24h7.5v-7.5z"/></svg>
          pnpm
        </button>
        <button class="cd-tab" data-pm="yarn" id="id-tab-yarn">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="#2c8ebb"><path d="M10.74 24a.555.555 0 01-.52-.36l-3.26-8.54L.15 8.26a.553.553 0 01-.2-.67.545.545 0 01.55-.32l8.83.65L12 0l2.67 7.92 8.83-.65a.553.553 0 01.55.32.548.548 0 01-.2.67l-6.81 6.84-3.26 8.54a.554.554 0 01-.52.36z"/></svg>
          yarn
        </button>
        <button class="cd-tab" data-pm="bun" id="id-tab-bun">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="#fbf0df"><path d="M14.54 11.23a4.73 4.73 0 0 0 4.09-2.3 4.8 4.8 0 0 0-4.09-7.1 4.73 4.73 0 0 0-4.09 2.3A4.8 4.8 0 0 0 6.36 1.83a4.73 4.73 0 0 0-4.09 7.1 4.8 4.8 0 0 0 4.09 2.3h8.18ZM6.36 4.78a2.38 2.38 0 0 1 2.05 1.15 2.4 2.4 0 0 1-2.05 3.55 2.38 2.38 0 0 1-2.05-1.15 2.4 2.4 0 0 1 2.05-3.55Zm8.18 0a2.38 2.38 0 0 1 2.05 1.15 2.4 2.4 0 0 1-2.05 3.55 2.38 2.38 0 0 1-2.05-1.15 2.4 2.4 0 0 1 2.05-3.55Zm-8.18 8.24A4.73 4.73 0 0 0 2.27 15.3a4.8 4.8 0 0 0 4.09 7.1h8.18a4.73 4.73 0 0 0 4.09-2.3 4.8 4.8 0 0 0-4.09-7.1H6.36Zm0 2.95h8.18a2.38 2.38 0 0 1 2.05 1.15 2.4 2.4 0 0 1-2.05 3.55H6.36a2.38 2.38 0 0 1-2.05-1.15 2.4 2.4 0 0 1 2.05-3.55Z"/></svg>
          bun
        </button>
      </div>
    </div>
    <div class="cd-body">
      <pre class="cd-code"><code id="id-code-container">npm i whatsbotcord</code></pre>
    </div>
  </div>
</section>

<style>
  .install-demo {
    max-width: 52rem;
    margin: 0 auto 3rem;
    padding-inline: 1rem;
  }
  .cd-window {
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
    background: #0d1117;
  }
  .cd-titlebar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 1rem;
    background: #161b22;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  .cd-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
  }
  .cd-dot--red { background: #ff5f57; }
  .cd-dot--yellow { background: #ffbd2e; }
  .cd-dot--green { background: #28c840; }
  .cd-tabs {
    display: flex;
    gap: 0.5rem;
    margin-left: 1rem;
  }
  .cd-tab {
    padding: 0.25rem 0.75rem;
    background: transparent;
    border: none;
    color: var(--sl-color-gray-3);
    font-size: 0.85rem;
    font-family: inherit;
    cursor: pointer;
    border-radius: 0.35rem 0.35rem 0 0;
    transition: background 0.15s, color 0.15s;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .cd-tab:hover { color: var(--sl-color-gray-1); }
  .cd-tab.active {
    background: #0d1117;
    color: var(--sl-color-accent-high, #d0f5dc);
    border-bottom: 2px solid var(--sl-color-accent, #22a34b);
  }
  .cd-body {
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
  }
  .cd-code {
    margin: 0;
    padding: 0;
    background: transparent !important;
    border: none !important;
    font-size: 1.1rem;
    font-family: "JetBrains Mono", "Fira Code", ui-monospace, "Cascadia Code", Menlo, monospace;
    color: #ffffff;
  }
</style>

<script>
  (function initInstallDemo() {
    function boot() {
      const tabs = {
        npm: document.getElementById('id-tab-npm'),
        pnpm: document.getElementById('id-tab-pnpm'),
        yarn: document.getElementById('id-tab-yarn'),
        bun: document.getElementById('id-tab-bun')
      };
      const codeContainer = document.getElementById('id-code-container');
      
      if (!codeContainer || !tabs.npm) return;

      const commands: Record<string, string> = {
        npm: "npm i whatsbotcord",
        pnpm: "pnpm add whatsbotcord",
        yarn: "yarn add whatsbotcord",
        bun: "bun add whatsbotcord"
      };

      function setPm(pm: string) {
        Object.values(tabs).forEach(t => t?.classList.remove('active'));
        tabs[pm as keyof typeof tabs]?.classList.add('active');
        codeContainer!.innerText = commands[pm];
        localStorage.setItem("wb-pm", pm);
      }

      Object.entries(tabs).forEach(([pm, el]) => {
        el?.addEventListener('click', () => setPm(pm));
      });

      const stored = localStorage.getItem("wb-pm") || "npm";
      if (commands[stored]) setPm(stored);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", boot);
    } else {
      boot();
    }
    document.addEventListener("astro:page-load", boot);
  })();
</script>
