---
/**
 * ThemePicker — lets users switch the site accent colour.
 * Rendered inside a custom Header override, positioned in the top-right.
 */
---

<div class="theme-picker" id="theme-picker" aria-label="Choose accent color">
  <button class="tp-swatch" data-theme="green"  style="--swatch:#22a34b" title="Green (default)"></button>
  <button class="tp-swatch" data-theme="blue"   style="--swatch:#3b82f6" title="Blue"></button>
  <button class="tp-swatch" data-theme="purple" style="--swatch:#8b5cf6" title="Purple"></button>
  <button class="tp-swatch" data-theme="orange" style="--swatch:#f97316" title="Orange"></button>
  <button class="tp-swatch" data-theme="teal"   style="--swatch:#14b8a6" title="Teal"></button>
  <button class="tp-swatch" data-theme="rose"   style="--swatch:#f43f5e" title="Rose"></button>
</div>
